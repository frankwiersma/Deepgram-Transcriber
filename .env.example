# Deepgram API Key (required)
DEEPGRAM_API_KEY=your_api_key_here

# Server Port (optional, defaults to 3456)
PORT=3456

# Node Environment (optional, defaults to production)
NODE_ENV=production

# Use EU Endpoint (optional, defaults to true)
# Set to 'false' to use US endpoint (api.deepgram.com) - Required for Nova-3 model
# Set to 'true' to use EU endpoint (api.eu.deepgram.com) - GDPR compliant
USE_EU_ENDPOINT=false
