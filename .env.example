# Deepgram API Key (required)
# Get your API key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_api_key_here

# Server Port (optional, defaults to 3456)
PORT=3456

# Node Environment (optional, defaults to production)
NODE_ENV=production

# Use EU Endpoint (optional, defaults to true)
# Set to 'false' to use US endpoint (api.deepgram.com)
# Set to 'true' or omit to use EU endpoint (api.eu.deepgram.com)
USE_EU_ENDPOINT=true
